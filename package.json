{
  "name": "bayarkita",
  "version": "2.0.0",
  "private": true,
  "description": "Jasa pembayaran luar negeri: situs statis + web chat + admin, berjalan di Cloudflare Pages + D1.",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=bayarkita --local",
    "db:migrate:local": "wrangler d1 execute bayarkita --local --file=./schema.sql",
    "db:migrate": "wrangler d1 execute bayarkita --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
